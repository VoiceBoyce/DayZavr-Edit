ButtonWidgetClass CraftProcessButton {
 size 50 50
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style Empty
 {
  PanelWidgetClass CraftProcesstemPanelWidget {
   ignorepointer 1
   color 0.098 0.098 0.098 0.235
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
   {
    PanelWidgetClass CraftProcessItemPanelW {
     ignorepointer 1
     color 0.337 0.302 0.282 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     style Outline
    }
   }
  }
  ImageWidgetClass RecipesImagePreview {
   ignorepointer 1
   color 0.455 0.455 0.455 0.416
   size 46 46
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   image0 "set:drl_craft_error image:error"
   mode blend
   "src alpha" 1
   "clamp mode" wrap
   "stretch mode" stretch_w_h
  }
  ItemPreviewWidgetClass RecipesItemPreview {
   ignorepointer 1
   size 46 46
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
  ProgressBarWidgetClass CraftProcessProgressBar {
   visible 1
   ignorepointer 1
   color 0.149 0.478 0.314 0.667
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style Quantity
   vertical 1
   flipped 1
  }
  ButtonWidgetClass CancelButton {
   visible 0
   size 0.3 0.3
   halign right_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style Empty
   {
    TextWidgetClass CancelText {
     ignorepointer 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     text "X"
     font "gui/fonts/metron-bold16"
     "exact text" 1
     "text halign" center
     "text valign" center
    }
   }
  }
  PanelWidgetClass QueuePanel {
   visible 0
   ignorepointer 1
   position 1 1
   size 0.26 0.26
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   {
    ImageWidgetClass QueueIcon {
     ignorepointer 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     imageTexture "{C5BCE765D32D5660}DRL_CraftMenu/UI/data/deseasesshow.edds"
     mode blend
     "src alpha" 1
     "clamp mode" wrap
     "stretch mode" stretch_w_h
     filter 1
    }
   }
  }
 }
}