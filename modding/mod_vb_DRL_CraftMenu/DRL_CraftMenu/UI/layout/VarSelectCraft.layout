ButtonWidgetClass VarSelectCraftButton {
 size 15 15
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style Empty
 {
  PanelWidgetClass VarSelectCraftP {
   ignorepointer 1
   color 0.753 0.741 0.741 0.235
   size 1 1
