   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style dashed
  }
  TextWidgetClass VarSelectCraftNumber {
   ignorepointer 1
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   text "1"
   font "gui/fonts/metron-bold14"
   "exact text" 1
   "text halign" center
   "text valign" center
  }
 }
}