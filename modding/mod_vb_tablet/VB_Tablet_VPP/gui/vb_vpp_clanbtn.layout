  }
  ButtonWidgetClass vbt_button_clan {
   position 0 0.1
   size 1 0.8
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Default
   text "#STR_VB_TAB_VPP_TO_CLAN"
   font "gui/fonts/metron"
  }
 }
}
