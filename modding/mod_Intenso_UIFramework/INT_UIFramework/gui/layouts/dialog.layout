FrameWidgetClass IufDialog {
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 position 0 0
 size 1 1
 {
  ImageWidgetClass Shade {
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   position 0 0
   size 1 1
   image0 "INT_UIFramework/gui/textures/white.paa"
   mode blend
   "src alpha" 1
   stretch 1
   ignorepointer 1
  }
  ButtonWidgetClass Blocker {
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   position 0 0
   size 1 1
   text ""
   style IufEmpty
  }
  FrameWidgetClass Panel {
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   position 0 0
   size 520 240
   halign center_ref
   valign center_ref
   clipchildren 0
  }
 }
}
