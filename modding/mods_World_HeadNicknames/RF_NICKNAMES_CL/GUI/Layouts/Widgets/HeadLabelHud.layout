GridSpacerWidgetClass rootFrame {
 size 100 60
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 Padding 0
 Margin 0
 "Size To Content H" 1
 "Size To Content V" 1
 content_valign center
 Rows 1
 {
  GridSpacerWidgetClass GridSpacerWidget1 {
   ignorepointer 1
   size 20 20
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   Padding 0
   Margin 0
   content_halign center
   content_valign center
   Columns 1
   Rows 1
   {
    ImageWidgetClass IconImageWidget {
     ignorepointer 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     imageTexture "{83A818074CD29AFE}RF_NICKNAMES_CL/GUI/Icons/playerIcon.edds"
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
   }
  }
  PanelWidgetClass sep {
   ignorepointer 1
   size 5 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
  }
  GridSpacerWidgetClass GridSpacerWidget0 {
   ignorepointer 1
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   Padding 0
   Margin 0
   "Size To Content H" 1
   "Size To Content V" 1
   content_valign center
   Columns 1
   Rows 2
   {
    TextWidgetClass PlayerNameTextWidget {
     ignorepointer 1
     size 1 20
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "cursor marker"
     font "gui/fonts/etelkatextpro16"
     "size to text h" 1
     "size to text v" 1
     "text halign" center
     "text valign" center
    }
    TextWidgetClass TimeTextWidget {
     visible 0
     ignorepointer 1
     size 1 20
     halign center_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     font "gui/fonts/etelkatextpro14"
     "size to text h" 1
     "size to text v" 1
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}